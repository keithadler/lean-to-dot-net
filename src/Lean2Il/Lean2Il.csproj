<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lean2il</AssemblyName>
    <RootNamespace>LeanToDotNet</RootNamespace>
    <Description>Compile Lean 4 definitions to a .NET assembly, after re-checking every proof about them with Tenet.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lean2il</ToolCommandName>
    <PackageId>lean2il</PackageId>
    <PackageTags>lean;lean4;theorem-prover;formal-verification;il;reflection-emit;tenet;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tenet, the independent Lean 4 kernel on .NET, reads the .olean files and re-checks them. It comes
         from nuget.org on restore; nothing to install by hand. -->
    <PackageReference Include="Tenet.Olean" Version="0.11.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

  <!-- Ship the two reference assemblies an emitted assembly refers to, System.Runtime and System.Runtime.Numerics,
       beside lean2il, so emitting needs only the .NET runtime, not the SDK. They come from the targeting pack this
       project is compiled against, and are MIT-licensed like the rest of .NET. -->
  <Target Name="CopyReferenceAssemblies" AfterTargets="Build">
    <ItemGroup>
      <_Lean2IlRef Include="@(ReferencePath)" Condition="'%(Filename)' == 'System.Runtime' Or '%(Filename)' == 'System.Runtime.Numerics'" />
    </ItemGroup>
    <Copy SourceFiles="@(_Lean2IlRef)" DestinationFolder="$(OutDir)ref" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishReferenceAssemblies" AfterTargets="Publish">
    <ItemGroup>
      <_Lean2IlRefPub Include="$(OutDir)ref/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_Lean2IlRefPub)" DestinationFolder="$(PublishDir)ref" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../LeanToDotNet.Runtime/LeanToDotNet.Runtime.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
